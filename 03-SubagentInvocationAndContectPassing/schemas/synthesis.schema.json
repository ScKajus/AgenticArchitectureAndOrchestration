{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.schema.json",
  "title": "Synthesis output",
  "description": "Output returned by the synthesizer subagent. Statements reference findings by id; the findings themselves are carried through with their content and metadata unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "sections", "conflicts", "gaps", "findings"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "goal", "inputs", "findings_received", "findings_cited"],
      "properties": {
        "agent": { "const": "synthesizer" },
        "goal": { "type": "string", "description": "The overall goal as received from the coordinator." },
        "inputs": {
          "description": "One entry per subagent output received, with its run-level metadata copied unchanged.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "metadata", "finding_count"],
            "properties": {
              "label": { "type": "string", "pattern": "^[A-Z][0-9]+$", "description": "Label assigned by the coordinator, e.g. W1, D1, W2." },
              "metadata": { "$ref": "findings.schema.json#/properties/metadata" },
              "finding_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "findings_received": { "type": "integer", "minimum": 0, "description": "Sum of finding_count over all inputs. Must equal the length of the findings array." },
        "findings_cited": { "type": "integer", "minimum": 0, "description": "Distinct finding ids referenced by at least one statement or conflict." }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "statements"],
        "properties": {
          "heading": { "type": "string" },
          "statements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "finding_ids", "confidence"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "finding_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[A-Z][0-9]+-F[0-9]+$" }
                },
                "confidence": { "enum": ["high", "medium", "low"] }
              }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "finding_ids", "resolution"],
        "properties": {
          "description": { "type": "string" },
          "finding_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^[A-Z][0-9]+-F[0-9]+$" } },
          "resolution": { "type": ["string", "null"], "description": "Why one side is better supported, or why they differ (date, method, scope). null if unresolved." }
        }
      }
    },
    "gaps": {
      "description": "Every gap from the inputs (prefixed with its label) plus any gap noticed during synthesis.",
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "description": "Every finding from every input, in input order. Only the id is changed (prefixed with the input label); content and metadata are copied unchanged.",
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "findings.schema.json#/$defs/finding" },
          { "properties": { "id": { "pattern": "^[A-Z][0-9]+-F[0-9]+$" } } }
        ]
      }
    }
  }
}
